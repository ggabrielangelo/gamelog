# ======================================================================
# GameLog — variáveis de ambiente de exemplo
# Copie para `.env` (ou para `apps/api/.env` e `apps/web/.env`) antes de
# rodar a aplicação. Nunca commitar o `.env` real.
# ======================================================================

# ---- Backend (apps/api) ------------------------------------------------

# Porta HTTP do Express.
PORT=3333

# URL do banco Prisma (PostgreSQL — ver Seção 2 do CLAUDE.md).
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Segredo usado para assinar os JWTs. Trocar em produção.
JWT_SECRET="troque-este-segredo-em-producao"

# Validade do token (string aceita por `jsonwebtoken`, ex.: "24h", "7d").
JWT_EXPIRES_IN="24h"

# Origem permitida pelo CORS (frontend em dev).
CORS_ORIGIN="http://localhost:5173"

# Token do endpoint protegido `/api/admin/reset` (usado pelo
# `cy.task('resetDatabase')` quando o experimento roda contra um banco
# remoto). Gerar com `openssl rand -hex 32` e manter apenas no `.env`.
ADMIN_TOKEN="troque-este-token-em-producao"

# ---- Frontend (apps/web) ----------------------------------------------

# URL base da API consumida pelo axios.
VITE_API_URL="http://localhost:3333/api"
